# Mindmap Learning Project — environment template
# Copy this file to `.env` and fill in real values.
# DO NOT put real secrets into this file.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Local/test fixture compatibility only; live Supabase tokens use ES256/JWKS above.
SUPABASE_JWT_SECRET=local_test_fixture_secret_only
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

SENTRY_DSN_BACKEND=your_backend_dsn_here
EXPO_PUBLIC_SENTRY_DSN_MOBILE=your_mobile_dsn_here
